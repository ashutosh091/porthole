# Credentials for gluetun profiles that pick servers by country (profiles.example.toml section 3).
# Copy to ~/.config/porthole/secrets/vpn.env and chmod 600. Use one file per provider if you have several.
# Variable names: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers

# WireGuard: from your provider's "manual setup" page (generate a key pair, copy the private key and address).
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# OpenVPN instead (vpn = "openvpn"): the provider's service credentials, usually not your account login.
# OPENVPN_USER=
# OPENVPN_PASSWORD=
